{
  "assumptions": {
    "setClassMethods": true,
    "constantSuper": true,
    "superIsCallableConstructor": true,
    "noClassCalls": true,
    "noClassPrototypeAssign": true,
    "noConstructorPrimitiveReturn": true,
    "iterableIsArray": true
  },
  "plugins": [
    "transform-function-name",
    "transform-classes",
    "transform-spread",
    "transform-block-scoping"
  ]
}
